bazel_dep(name = "gazelle", version = "0.37.0")
bazel_dep(name = "rules_go", version = "0.50.1")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "rules_cc", version = "0.0.16")
bazel_dep(name = "rules_java", version = "8.6.1")
bazel_dep(name = "grpc", version = "1.69.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")

# Download a suitable Go SDK.
go_sdk.download(version = "1.23.3")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
# go_deps = use_extension("@bazel_gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

use_extension("@rules_proto//proto:extensions.bzl", "rules_proto_dependencies")
use_extension("@rules_proto//proto:extensions.bzl", "rules_proto_toolchains")
use_extension("@rules_cc//cc:extensions.bzl", "rules_cc_dependencies")
use_extension("@rules_java//java:extensions.bzl", "rules_java_dependencies")

